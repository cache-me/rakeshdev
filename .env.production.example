# Copy values into Vercel / Render dashboards — do not commit real secrets.

# --- Supabase Postgres (REQUIRED on Render: Transaction pooler — NOT Direct) ---
# Direct db.PROJECT.supabase.co:5432 is IPv6-only → ENETUNREACH on Render free.
# Copy from Supabase → Settings → Database → Connection string → Transaction pooler:
DATABASE_URL=postgresql://postgres.xzbcqrpxlsbiogdymuen:PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# --- API (Render / Railway / Fly) ---
PORT=3000
NODE_ENV=production
BETTER_AUTH_SECRET=generate-a-long-random-string-at-least-32-chars
# Must match the public website origin (Vercel URL or custom domain)
BETTER_AUTH_URL=https://your-app.vercel.app
CORS_ORIGIN=https://your-app.vercel.app

# Optional
AI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Vercel (apps/web) ---
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Public URL of the API service (no trailing slash)
API_URL=https://portfolio-api.onrender.com
