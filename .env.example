# Database
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5433/portfolio

# API
PORT=3000
CORS_ORIGIN=http://localhost:3001
BETTER_AUTH_SECRET=dev-only-secret-change-in-production-32chars
# Public site origin (auth cookies + Better Auth base URL when using Next /api rewrite)
BETTER_AUTH_URL=http://localhost:3001

# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# SSR uses NEXT_PUBLIC_SITE_URL + /api (Next rewrite). Set API_SSR_DIRECT=true to hit API_URL from RSC.
API_URL=http://localhost:3000

# AI (optional — rule-based fallback when AI_API_KEY is unset)
AI_API_KEY=
AI_PROVIDER=anthropic
# Optional; defaults to https://api.anthropic.com/v1 (anthropic) or OpenAI URL when AI_PROVIDER=openai
AI_BASE_URL=
AI_MODEL=claude-3-5-haiku-20241022

# Resume PDF (Playwright Chromium — run once: pnpm --filter @portfolio/api exec playwright install chromium)
# Contact form email (Resend — https://resend.com)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=you@example.com
# Set to false to skip visitor confirmation email
CONTACT_AUTO_REPLY=true
